#!/bin/sh
# Запуск закрытых клиентов NavDat (Ubuntu 16.04) в контейнере podman.
#
#   navdat-legacy build <каталог с оригинальными deb>   собрать образ
#   navdat-legacy run <клиент> [аргументы...]           запустить клиента
#
# Контейнер работает в сетевом пространстве хоста (--network host), поэтому
# видит abstract-сокет @/bortd/$USER демона bortd, запущенного на хосте.
set -e

IMAGE=localhost/navdat-legacy:xenial
SHARE=/usr/share/navdat-legacy
# пакеты, которые нужны клиентам внутри контейнера
PKGS="libfox-gt_ fox-gt_ navdat-clients-common_ navdat-clients-equator_
      navdat-clients-gtmag_ navdat-clients-specview_ navdat-clients-tvisor_ navdat-help_"

case "$1" in
build)
    SRC=${2:?usage: navdat-legacy build <dir-with-original-debs>}
    CTX=$(mktemp -d)
    trap 'rm -rf "$CTX"' EXIT
    mkdir "$CTX/debs"
    for p in $PKGS; do
        f=$(ls "$SRC"/${p}*.deb 2>/dev/null | grep -v '+noble' | head -n1)
        [ -n "$f" ] || { echo "missing ${p}*.deb in $SRC" >&2; exit 1; }
        cp "$f" "$CTX/debs/"
    done
    cp "$SHARE/Containerfile" "$CTX/"
    exec podman build -t "$IMAGE" "$CTX"
    ;;
run)
    shift
    [ -n "$1" ] || { echo "usage: navdat-legacy run <client> [args]" >&2; exit 1; }
    set -- "$@"
    XAUTH=${XAUTHORITY:-$HOME/.Xauthority}
    exec podman run --rm --network host --ipc host --userns keep-id \
        -e DISPLAY -e USER="$(id -un)" -e HOME="$HOME" -e LANG -e BORT_SERVER \
        -v /tmp/.X11-unix:/tmp/.X11-unix -v "$XAUTH:$XAUTH:ro" -e XAUTHORITY="$XAUTH" \
        -v "$HOME:$HOME" -w "$HOME" \
        "$IMAGE" "$@"
    ;;
*)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
