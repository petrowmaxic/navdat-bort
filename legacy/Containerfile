# Образ для закрытых клиентов NavDat, собранных под Ubuntu 16.04 (Qt4, Qwt, libglade2).
# Собирается командой: navdat-legacy build <каталог с оригинальными deb>
FROM docker.io/library/ubuntu:16.04

ENV DEBIAN_FRONTEND=noninteractive
COPY debs/ /tmp/debs/
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        /tmp/debs/*.deb fonts-dejavu-core xfonts-75dpi xfonts-100dpi xdg-utils \
 && rm -rf /var/lib/apt/lists/* /tmp/debs
